# Mobile API Base URL
# Web browser: http://localhost:4000
# Android emulator: http://10.0.2.2:4000
# iOS simulator: http://localhost:4000
# Physical phone: uncomment this and replace the address with the computer's
# LAN IPv4 address. Do not use localhost on a physical phone.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
#
# Leave this unset for the web app and Expo simulator defaults. For a physical
# device, create mobile/.env with the LAN address above and restart Expo.
